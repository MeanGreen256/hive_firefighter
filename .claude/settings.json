{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh api *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh ruleset *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh auth *)",
      "Bash(gh pr merge *)",
      "Bash(gh label delete *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(npm publish*)"
    ],
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)"
    ]
  }
}
